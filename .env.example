PORT=4000
# Frontend origins allowed by CORS, comma-separated (local Vite dev server + deployed site)
CORS_ORIGIN=http://localhost:5173

# --- ElevenLabs voice layer ---
# API key: elevenlabs.io > Developers > API keys. Backend only, never put it in the frontend.
ELEVENLABS_API_KEY=
# Voice used for narration and the guide (pick one in the ElevenLabs Voice Library)
ELEVENLABS_VOICE_ID=
# Optional overrides
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# LLM the agents run on, hosted by ElevenLabs (re-run `npm run agents:sync` after changing)
ELEVENLABS_AGENT_LLM=gemini-2.5-flash
# Filled in after running: npm run agents:sync
ELEVENLABS_NARRATOR_AGENT_ID=
ELEVENLABS_GUIDE_AGENT_ID=
ELEVENLABS_PLACE_AGENT_ID=
